   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "a = np.array([1, 1.1, 1.3, 1.6, 2, 2.5, 3.1, 3.8, 4.6, 5.5])\n",
    "\n",
    "a = pd.DataFrame(a.reshape(-1, 1))\n",
    "\n",
    "for col in a.columns:\n",
    "    print(a[col].rolling(window=3, min_periods=1).mean())"
   ]
  }
